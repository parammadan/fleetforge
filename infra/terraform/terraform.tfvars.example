# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# No credentials belong in this file — only a profile name. FleetForge's threat
# model forbids secret keys in source (THREAT_MODEL.md, section 5).

# A named AWS CLI profile with permission to create EKS, EC2, VPC, and IAM
# resources. SSO is preferred over static keys.
aws_profile = "fleetforge"

region = "us-east-2"

# Lock the public API endpoint to your own address.
#   curl -s ifconfig.me
allowed_public_cidr = "203.0.113.4/32"

# A Bottlerocket release BEHIND current, so Brupop has something to update.
#   aws ssm get-parameters-by-path \
#     --path /aws/service/bottlerocket/aws-k8s-1.36/arm64 --recursive \
#     --query 'Parameters[].Name' --profile fleetforge
#
# bottlerocket_release_version = "1.19.5-82ec1d16"
