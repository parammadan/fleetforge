# Rust
/target/
**/target/
*.pdb

# Node
node_modules/
web/dist/
web/playwright-report/
web/test-results/
.vite/
*.tsbuildinfo

# Secrets — never commit
.env
.env.*
!.env.example
*.kubeconfig
kubeconfig*
*.pem
*.key
*.crt
credentials
.aws/

# Generated cluster credentials. Short-lived tokens, never committed.
infra/local/.kubeconfig-*
infra/eks/.kubeconfig-*
*.token

# Terraform
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.tfstate.lock.info
# Plans are binary and embed the full resolved configuration, including any
# value marked sensitive. They are never committed.
*.tfplan
*.tfplan.json
# tfvars carry account-specific values: profile names, source CIDRs.
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Generated kubeconfigs and any credential material
kubeconfig
kubeconfig-*
*.kubeconfig
.aws-sso-cache/

# Local data
*.db
*.sqlite
*.sqlite3
/data/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp



# Playwright artefacts. The walkthrough *output* is regenerated by
# `npm run walkthrough`; the published copy lives in docs/walkthrough/.
web/walkthrough-output/
web/test-results/
web/playwright-report/
